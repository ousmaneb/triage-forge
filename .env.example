# Copy to .env. Never commit .env.
ANTHROPIC_API_KEY=
TF_LLM_PROVIDER=anthropic
TF_LLM_MODEL=claude-opus-5-5
TF_LLM_EFFORT=medium
TF_WEBHOOK_TOKEN=change-me
SPLUNK_PASSWORD=change-me-8-chars-min
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000
# Sentinel is mocked locally. For a real workspace, set an Azure AD token with
# Microsoft Sentinel Responder rights.
SENTINEL_API_URL=https://management.azure.com
SENTINEL_TOKEN=
